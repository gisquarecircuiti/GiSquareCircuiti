{
  "id": "./",
  "name": "GiSquare Circuiti Web",
  "short_name": "GiSquare Web",
  "description": "Simulatore di circuiti elettronici, logica cablata, PLC e schede a microcontrollore per la scuola, nella versione web.",
  "lang": "it",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#12161c",
  "theme_color": "#12161c",
  "icons": [
    { "src": "icons/icon-web-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-web-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-web-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "application/x-gisquare-circuiti": [".gsq"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
